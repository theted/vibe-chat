{
  "name": "ai-chat",
  "version": "1.0.0",
  "description": "Real-time group chat between people and many AI models, with a CLI for AI-to-AI conversations",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "./start.sh",
    "cli": "bun run --filter @ai-chat/cli start",
    "chat:index": "bun packages/ai-chat-cli/scripts/index-mcp-chat.ts",
    "chat:ask": "bun packages/ai-chat-cli/scripts/run-mcp-chat.ts",
    "chat:mcp": "bun packages/mcp-assistant/src/mcp/stdio.ts",
    "build:configs": "turbo run build --filter=@ai-chat/ai-configs",
    "build:core": "turbo run build --filter=@ai-chat/core",
    "build:cli": "turbo run build --filter=@ai-chat/cli",
    "build:server": "turbo run build --filter=@ai-chat/server",
    "build:client": "turbo run build --filter=@ai-chat/client",
    "build": "turbo run build",
    "test": "turbo run test",
    "validate:models": "bun scripts/validate-ai-models.ts",
    "validate:models:live": "bun scripts/validate-ai-models.ts --live",
    "test:configs": "turbo run test --filter=@ai-chat/ai-configs",
    "test:core": "turbo run test --filter=@ai-chat/core",
    "test:client": "turbo run test --filter=@ai-chat/client",
    "test:cli": "turbo run test --filter=@ai-chat/cli",
    "test:server": "turbo run test --filter=@ai-chat/server",
    "test:e2e": "codeceptjs run --steps --config codecept.conf.cjs",
    "test:live": "bun run --cwd packages/ai-chat-core test:live",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:client": "turbo run lint --filter=@ai-chat/client",
    "lint:server": "turbo run lint --filter=@ai-chat/server",
    "lint:core": "turbo run lint --filter=@ai-chat/core",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose up --build",
    "docker:debug": "docker compose -f docker-compose.debug.yml up --build",
    "docker:clean": "docker compose down --volumes && docker system prune -f"
  },
  "devDependencies": {
    "@eslint/js": "8.57.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "codeceptjs": "^3.7.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^13.24.0",
    "playwright": "^1.55.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "ai",
    "chat",
    "realtime",
    "websocket",
    "react",
    "bun",
    "openai",
    "anthropic"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.2.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
