# AI provider API keys. Set the ones you have; models without a key are skipped.
# Direct APIs:
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROK_API_KEY=your_grok_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
LLAMA_API_KEY=your_llama_api_key_here
Z_API_KEY=your_z_ai_api_key_here
# Everything else (Gemini, Mistral, Kimi, Qwen, Perplexity and ~30 more labs)
# runs through OpenRouter on this one key:
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_APP_NAME=Vibe Chat
# OPENROUTER_APP_URL=http://localhost:3000

# Server configuration (used by packages/server and docker-compose)
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379

# Server behavior flags
AI_CHAT_VERBOSE_CONTEXT=false
AI_CHAT_SKIP_HEALTHCHECK=false
# Ignore model-health.json and re-check every model in the background
AI_CHAT_RECHECK_AVAILABILITY=false
# How long a passed health check is trusted (default 24h)
# AI_CHAT_HEALTH_TTL_MS=86400000
# MODEL_HEALTH_PATH=/absolute/path/to/model-health.json
# Server-only disable, comma-separated participant IDs (e.g. OPENAI_GPT5_5)
# DISABLED_AI_MODELS=
# Comma-separated OpenAI model keys to load instead of all active ones
# OPENAI_MODEL_ALLOWLIST=

# @Chat assistant (server + `bun run chat:index` / `chat:ask`). Needs
# ANTHROPIC_API_KEY, plus the key for the embeddings provider below:
# MISTRAL_API_KEY, OPENAI_API_KEY, GOOGLE_AI_API_KEY or COHERE_API_KEY.
# Mistral and Gemini keys are only used for these embeddings.
MISTRAL_API_KEY=your_mistral_api_key_here
# GOOGLE_AI_API_KEY=your_google_ai_api_key_here
# CHAT_ASSISTANT_EMBEDDINGS=mistral   # mistral (default) | openai | gemini | cohere
# CHAT_ASSISTANT_MODEL=claude-opus-5-5
CHAT_ASSISTANT_AUTO_INDEX=false
CHAT_ASSISTANT_COLLECTION=ai-chat-workspace
CHROMA_URL=http://localhost:8000
# CHAT_ASSISTANT_ROOT=/absolute/path/to/repo

# CLI configuration
LOG_LEVEL=info
MAX_CONVERSATION_TURNS=10
CONVERSATION_TIMEOUT_MS=300000
# The CLI's stats tracker uses REDIS_URL, or these:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional overrides for Z.ai
# Z_BASE_URL=https://api.z.ai/api/paas/v4
# Z_MODEL_ID=glm-5.2
