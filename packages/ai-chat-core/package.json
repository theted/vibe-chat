{
  "name": "@ai-chat/core",
  "version": "1.0.0",
  "description": "Core AI service wrappers, configuration, and utilities shared across AI Chat apps",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly --outDir dist && swc src -d dist --strip-leading-paths && bun ../../scripts/resolve-path-aliases.mjs .",
    "build:watch": "swc src -d dist --watch & tsc --noEmit --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test": "bun test tests/unit/ tests/integration/",
    "test:live": "bun run build && bun tests/integration-ok.ts",
    "test:orchestrator-timing": "bun run build && bun test tests/integration-orchestrator-timing.test.ts",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-chat/ai-configs": "file:../ai-configs",
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^4.89.0"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "^15.1.0",
    "@swc/cli": "^0.3.0",
    "@swc/core": "^1.4.0",
    "@types/node": "^24.10.1",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "dotenv": "^16.4.7",
    "eslint": "^8.56.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "ai",
    "chat",
    "realtime",
    "websocket"
  ],
  "author": "AI Chat Team",
  "license": "MIT",
  "engines": {
    "bun": ">=1.2.0"
  }
}
